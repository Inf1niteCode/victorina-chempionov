// ────────────────────────────────────────────
// Викторина Чемпионов — Prisma Schema
// ────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────
// ПОЛЬЗОВАТЕЛИ (ведущие)
// ────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String
  emailVerified  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  games          Game[]
}

// ────────────────────────────────────────────
// ТЕМЫ И ВОПРОСЫ
// ────────────────────────────────────────────

model Theme {
  id          String          @id @default(cuid())
  name        String
  category    String          // ИСТОРИЯ|НАУКА|КУЛЬТУРА|СПОРТ|ГЕОГРАФИЯ
  questions   Question[]
  tourThemes  GameTourTheme[]
}

model Question {
  id           String       @id @default(cuid())
  text         String
  answer       String
  points       Int          // 100|200|300|400|500
  themeId      String
  questionType QuestionType @default(TEXT)
  mediaUrl     String?      // URL для IMAGE/AUDIO/VIDEO
  theme        Theme        @relation(fields: [themeId], references: [id])
  rounds       Round[]
}

// ────────────────────────────────────────────
// ИГРА
// ────────────────────────────────────────────

model Game {
  id          String     @id @default(cuid())
  code        String     @unique   // KVIZ42 — 6 символов
  hostId      String
  status      GameStatus @default(LOBBY)
  timerSecs   Int        @default(30)
  totalTours  Int        @default(1)
  currentTour Int        @default(1)
  createdAt   DateTime   @default(now())
  host        User       @relation(fields: [hostId], references: [id])
  players     Player[]
  tours       GameTour[]
  rounds      Round[]
}

model GameTour {
  id         String          @id @default(cuid())
  gameId     String
  tourNumber Int             // 1, 2 или 3
  status     TourStatus      @default(PENDING)
  game       Game            @relation(fields: [gameId], references: [id])
  themes     GameTourTheme[]
}

model GameTourTheme {
  id         String   @id @default(cuid())
  tourId     String
  themeId    String
  position   Int      // 1–5, порядок колонки на поле
  tour       GameTour @relation(fields: [tourId], references: [id])
  theme      Theme    @relation(fields: [themeId], references: [id])

  @@unique([tourId, position])
  @@unique([tourId, themeId])
}

model Player {
  id     String  @id @default(cuid())
  name   String
  score  Int     @default(0)
  gameId String
  game   Game    @relation(fields: [gameId], references: [id])
  rounds Round[]
}

model Round {
  id         String    @id @default(cuid())
  gameId     String
  questionId String
  tourNumber Int
  winnerId   String?
  correct    Boolean?
  createdAt  DateTime  @default(now())
  game       Game      @relation(fields: [gameId], references: [id])
  question   Question  @relation(fields: [questionId], references: [id])
  winner     Player?   @relation(fields: [winnerId], references: [id])

  @@unique([gameId, questionId])
}

// ────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────

enum GameStatus {
  LOBBY
  ACTIVE
  FINISHED
}

enum TourStatus {
  PENDING
  ACTIVE
  FINISHED
}

enum QuestionType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}
